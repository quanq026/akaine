# Binary releases belong in GitHub Releases, not Git history.
/apk/*.apk
/apk/*.idsig

# Large/private content is intentionally offloaded.
/assets/**
!/assets/.gitkeep
/bundle/**
!/bundle/.gitkeep
/server/assets/**
!/server/assets/.gitkeep
/server/database/bundle/**
!/server/database/bundle/.gitkeep
/server/database/songs/**
!/server/database/songs/.gitkeep

# Runtime state and secrets.
.env*
!.env.example
!**/.env.example
*.env
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.db
*.sqlite*
config.py
*.bak
*.bak-*
*.backup*
*.orig
*.tmp
__pycache__/
*.pyc
logs/
backups/
/manifests/sha256.json
/scripts/*_20[0-9][0-9][0-9][0-9][0-9][0-9]*

# Developer-local tools and generated inputs.
.venv/
venv/
.idea/
.vscode/
