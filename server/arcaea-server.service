[Unit]
Description=Arcaea private server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=akaine
Group=akaine
WorkingDirectory=/srv/akaine/repo/server
ExecStart=/srv/akaine/repo/.venv/bin/python /srv/akaine/repo/server/main.py
EnvironmentFile=/srv/akaine/repo/server/.asset-signing.env
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=15
UMask=0077
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
