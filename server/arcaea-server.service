[Unit]
Description=Arcaea private server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=akaine
Group=akaine
WorkingDirectory=/srv/akaine
ExecStart=/usr/bin/python3 /srv/akaine/main.py
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=15
UMask=0077
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
